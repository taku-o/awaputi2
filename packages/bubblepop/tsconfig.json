{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist",
    "rootDir": "../../",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "paths": {
      "@bubblepop/ui-library": ["../ui-library/src"],
      "@bubblepop/ui-library/*": ["../ui-library/src/*"]
    }
  },
  "include": ["src/**/*", "../ui-library/src/**/*"],
  "exclude": ["node_modules", "dist"]
}